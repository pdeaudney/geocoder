# Environment for geocoder.service. Edit on the running instance to
# override AMI defaults; systemd daemon-reload + restart picks up changes.
#
# Positional args for query-server:
#   $1  data_dir      baked into ExecStart as @INDEX_DIR@
#   $2  bind_addr     below
BIND_ADDR=@BIND_ADDR@

# Optional admin-mapping.json override. When set, must be readable by the
# service user.
# GEOCODER_ADMIN_CONFIG=/etc/geocoder/admin-mapping.json

# Optional hot-reload marker. `touch`ing this file triggers an atomic
# index re-mmap without restarting the service. Useful when operators
# sync a fresh index from S3 in-place.
# GEOCODER_RELOAD_MARKER=@INDEX_DIR@/reload.marker
# GEOCODER_RELOAD_INTERVAL_SEC=30

# Optional gRPC listener. Defaults to 0.0.0.0:3001 when enabled at build
# time (feature=grpc). Leave unset to disable.
# GEOCODER_GRPC_ADDR=0.0.0.0:3001
