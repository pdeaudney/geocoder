      },
      "expect": {
        "status": 200,
        "checks": [
          { "kind": "json_path_exists", "path": "address" }
        ]
      }
    },
    {
      "id": "validate-alysse-close-10",
      "tags": ["validate", "gnaf"],
      "request": {
        "path": "/validate",
