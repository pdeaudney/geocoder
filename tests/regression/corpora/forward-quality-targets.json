{
  "name": "forward-quality-targets",
  "description": "Real US/CA addresses from the Pelias failure triage. Check the result's location and stable address fields without requiring Pelias's display spelling.",
  "cases": [
    {
      "id": "us-direction-southeast",
      "request": { "method": "GET", "path": "/search", "query": { "q": "186 Tuskegee St SE Atlanta GA" } },
      "expect": { "status": 200, "checks": [
        { "kind": "result_matches_within", "limit": 1, "fields": { "address.country_code": "US", "address.house_number": "186", "address.postcode": "30315" } },
        { "kind": "result_coord_within", "limit": 1, "expected_lat": 33.728779, "expected_lng": -84.381759, "max_m": 150 }
      ] }
    },
    {
      "id": "us-direction-west",
      "request": { "method": "GET", "path": "/search", "query": { "q": "30 W 26th St, New York, NY 10010" } },
      "expect": { "status": 200, "checks": [
        { "kind": "result_matches_within", "limit": 1, "fields": { "address.country_code": "US", "address.house_number": "30", "address.postcode": "10010" } },
        { "kind": "result_coord_within", "limit": 1, "expected_lat": 40.74421, "expected_lng": -73.99037, "max_m": 150 }
      ] }
    },
    {
      "id": "us-conflicting-zip",
      "request": { "method": "GET", "path": "/search", "query": { "q": "267 e 10th st, new york, ny 10010" } },
      "expect": { "status": 200, "checks": [
        { "kind": "result_matches_within", "limit": 1, "fields": { "address.country_code": "US", "address.house_number": "267", "address.postcode": "10009" } },
        { "kind": "result_coord_within", "limit": 1, "expected_lat": 40.72842, "expected_lng": -73.98313, "max_m": 150 }
      ] }
    },
    {
      "id": "us-hyphenated-house",
      "request": { "method": "GET", "path": "/search", "query": { "q": "85-23 168th Place queens ny" } },
      "expect": { "status": 200, "checks": [
        { "kind": "result_matches_within", "limit": 1, "fields": { "address.country_code": "US", "address.house_number": "85-23" } },
        { "kind": "result_coord_within", "limit": 1, "expected_lat": 40.71323, "expected_lng": -73.79507, "max_m": 150 }
      ] }
    },
    {
      "id": "us-sf-jackson-oa",
      "request": { "method": "GET", "path": "/search", "query": { "q": "3577 Jackson St San Francisco, CA 94118" } },
      "expect": { "status": 200, "checks": [
