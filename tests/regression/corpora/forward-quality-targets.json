      "request": { "method": "GET", "path": "/search", "query": { "q": "280 Bloor Street West টরোন্টো オンタリオ州 کانادا" } },
      "expect": { "status": 200, "checks": [
        { "kind": "result_matches_within", "limit": 1, "fields": { "address.country_code": "CA", "address.house_number": "280" } },
