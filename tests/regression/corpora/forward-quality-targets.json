        { "kind": "result_coord_within", "limit": 1, "expected_lat": 37.7897992, "expected_lng": -122.4536603, "max_m": 150 }
      ] }
    },
    {
      "id": "us-va-kensington-oa",
      "request": { "method": "GET", "path": "/search", "query": { "q": "15364 Kensington Park Dr, Woodbridge, VA" } },
      "expect": { "status": 200, "checks": [
        { "kind": "result_matches_within", "limit": 1, "fields": { "address.country_code": "US", "address.house_number": "15364" } },
        { "kind": "result_coord_within", "limit": 1, "expected_lat": 38.624117, "expected_lng": -77.2821749, "max_m": 150 }
